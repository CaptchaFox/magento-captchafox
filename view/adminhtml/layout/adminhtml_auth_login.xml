<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="ScoriaLabs_CaptchaFox::css/captchafox.css" />
    </head>
    <body>
        <referenceContainer name="form.additional.info">
            <block name="captchafox.admin.login" class="CaptchaFox\Core\Block\CaptchaFox"
                cacheable="false" ifconfig="captchafox/adminhtml/enabled">
                <action method="setAction">
                    <argument name="action" xsi:type="string">login</argument>
                </action>
            </block>
            <block class="CaptchaFox\Core\Block\CaptchaFox\Config"
                template="ScoriaLabs_CaptchaFox::captchafox/config.phtml" cacheable="false"
                ifconfig="captchafox/adminhtml/enabled" />
        </referenceContainer>
    </body>
</page>