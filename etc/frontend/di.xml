<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="CaptchaFox\Core\Observer\Validate\Frontend">
        <arguments>
            <argument name="persistor" xsi:type="object">
                CaptchaFox\Core\Model\Persistor\Frontend</argument>
            <argument name="data" xsi:type="array">
                <item name="routes" xsi:type="array">
                    <item name="contact_index_post" xsi:type="string">contact</item>
                    <item name="customer_account_forgotpasswordpost" xsi:type="string">password</item>
                    <item name="customer_account_createpost" xsi:type="string">register</item>
                    <item name="customer_account_loginpost" xsi:type="string">login</item>
                    <item name="customer_ajax_login" xsi:type="string">login-ajax</item>
                    <item name="review_product_post" xsi:type="string">review</item>
                    <item name="sendfriend_product_sendmail" xsi:type="string">send-friend</item>
                    <item name="newsletter_subscriber_new" xsi:type="string">newsletter</item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="CaptchaFox\Core\Model\Persistor\Frontend">
        <arguments>
            <argument name="reviewSession" xsi:type="object">Magento\Review\Model\Session</argument>
        </arguments>
    </type>
    <preference for="CaptchaFox\Core\Model\ConfigProviderInterface"
        type="CaptchaFox\Core\Model\ConfigProvider\Frontend" />
</config>