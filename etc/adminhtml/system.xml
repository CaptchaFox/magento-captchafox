<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="captchafox" translate="label" type="text" sortOrder="900" showInDefault="1"
            showInWebsite="1" showInStore="1">
            <label>CaptchaFox</label>
            <tab>service</tab>
            <resource>ScoriaLabs_CaptchaFox::settings</resource>
            <group id="settings" translate="label" type="text" sortOrder="1" showInDefault="1"
                showInWebsite="1" showInStore="1">
                <label>Settings</label>
                <field id="sitekey" translate="label" type="text" sortOrder="20" showInDefault="1"
                    showInWebsite="1" showInStore="1">
                    <label>Site key</label>
                    <validate>required-entry</validate>
                </field>
                <field id="secret_key" translate="label" type="obscure" sortOrder="30"
                    showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Secret key</label>
                    <validate>required-entry</validate>
                </field>
            </group>
            <group id="frontend" translate="label" type="text" sortOrder="1" showInDefault="1"
                showInWebsite="1" showInStore="1">
                <label>Storefront</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1"
                    showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="theme" translate="label" type="select" sortOrder="20" showInDefault="1"
                    showInWebsite="1" showInStore="1">
                    <label>Theme</label>
                    <source_model>CaptchaFox\Core\Model\Config\Source\Theme</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="mode" translate="label" type="select" sortOrder="30" showInDefault="1"
                    showInWebsite="1" showInStore="1">
                    <label>Mode</label>
                    <source_model>CaptchaFox\Core\Model\Config\Source\Mode</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="language" translate="label" sortOrder="40" type="select"
                    showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Language Code</label>
                    <source_model>CaptchaFox\Core\Model\Config\Source\Language</source_model>
                </field>
                <field id="forms" translate="label" type="multiselect" sortOrder="50"
                    showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Forms to validate</label>
                    <source_model>CaptchaFox\Core\Model\Config\Source\Forms\Frontend</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
            <group id="adminhtml" translate="label" type="text" sortOrder="1" showInDefault="1"
                showInWebsite="0" showInStore="0">
                <label>Admin Panel</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1"
                    showInWebsite="0" showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="theme" translate="label" type="select" sortOrder="20" showInDefault="1"
                    showInWebsite="0" showInStore="0">
                    <label>Theme</label>
                    <source_model>CaptchaFox\Core\Model\Config\Source\Theme</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="mode" translate="label" type="select" sortOrder="30" showInDefault="1"
                    showInWebsite="0" showInStore="0">
                    <label>Mode</label>
                    <source_model>CaptchaFox\Core\Model\Config\Source\Mode</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="language" translate="label" sortOrder="40" type="select"
                    showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Language Code</label>
                    <source_model>CaptchaFox\Core\Model\Config\Source\Language</source_model>
                </field>
                <field id="forms" translate="label" type="multiselect" sortOrder="50"
                    showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Forms to validate</label>
                    <source_model>CaptchaFox\Core\Model\Config\Source\Forms\Adminhtml</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>